# Build environment for Fernhilfe (Linux x86_64).
# Mirrors upstream's build-rustdesk-linux job (.github/workflows/flutter-build.yml),
# but on Ubuntu 24.04: the resulting binaries need glibc >= 2.39.
# Versions below come from upstream's workflow files – check them on every upstream update
# (lui/update-upstream.sh prints them).
FROM docker.io/library/ubuntu:24.04

ARG RUST_VERSION=1.75
ARG FLUTTER_VERSION=3.24.5
ARG BRIDGE_FLUTTER_VERSION=3.22.3
ARG FRB_VERSION=1.80.1
ARG CARGO_EXPAND_VERSION=1.0.95
ARG VCPKG_COMMIT_ID=9e593bb18ea69cc5095e012465dcd675a822ed0d
ARG VCPKG_CMAKE_VERSION=4.3.0

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y && apt-get install -y --no-install-recommends \
      build-essential clang cmake curl gcc g++ git ca-certificates \
      libayatana-appindicator3-dev libasound2-dev libclang-dev llvm-dev \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libgtk-3-dev \
      libpulse-dev libva-dev libxcb-randr0-dev libxcb-shape0-dev libxcb-xfixes0-dev \
      libxdo-dev libxfixes-dev libssl-dev \
      nasm yasm ninja-build pkg-config python3 python3-pip \
      autoconf automake autoconf-archive libtool make \
      unzip zip wget xz-utils file patchelf desktop-file-utils squashfs-tools \
    && (apt-get remove -y libopus-dev || true) \
    && rm -rf /var/lib/apt/lists/*

# vcpkg at this commit needs CMake >= 4.3
RUN pip3 install --break-system-packages "cmake==${VCPKG_CMAKE_VERSION}" && cmake --version

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
      --default-toolchain ${RUST_VERSION} -c rustfmt \
    && cargo install cargo-expand --version ${CARGO_EXPAND_VERSION} --locked \
    && cargo install flutter_rust_bridge_codegen --version ${FRB_VERSION} --features uuid --locked \
    && rm -rf /opt/cargo/registry /opt/cargo/git

ENV VCPKG_ROOT=/opt/vcpkg VCPKG_FORCE_SYSTEM_BINARIES=1
RUN git clone https://github.com/microsoft/vcpkg /opt/vcpkg \
    && git -C /opt/vcpkg checkout -q ${VCPKG_COMMIT_ID} \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics

# Flutter for the app, and the older one upstream uses to generate the Rust<->Dart bridge
RUN git config --global --add safe.directory '*' \
    && cd /opt \
    && wget -q https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz \
    && tar xf flutter_linux_${FLUTTER_VERSION}-stable.tar.xz && mv flutter flutter-app && rm *.tar.xz \
    && wget -q https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${BRIDGE_FLUTTER_VERSION}-stable.tar.xz \
    && tar xf flutter_linux_${BRIDGE_FLUTTER_VERSION}-stable.tar.xz && mv flutter flutter-bridge && rm *.tar.xz \
    && /opt/flutter-app/bin/flutter config --no-analytics \
    && /opt/flutter-app/bin/flutter precache --linux \
    && /opt/flutter-bridge/bin/flutter precache --linux

# appimagetool with the static type-2 runtime (no libfuse2 needed on the target)
RUN wget -q -O /usr/local/bin/appimagetool \
      https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
    && chmod +x /usr/local/bin/appimagetool

WORKDIR /src
